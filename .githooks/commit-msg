#!/usr/bin/env bash
# Reject commit messages that would be expensive to fix once published.
#
# Both of these have already happened here and cost a full history rewrite to
# undo (AGE-108). The rules themselves live in CLAUDE.md.
#
# Enabled by ./dev.sh, which sets core.hooksPath. To run it by hand:
#   git config core.hooksPath .githooks
#
# To bypass deliberately, commit with --no-verify.
set -euo pipefail

MSG_FILE="$1"
# Strip comment lines; git's own template would otherwise trip the scan.
BODY="$(grep -v '^#' "$MSG_FILE" || true)"

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  See CLAUDE.md. Bypass with --no-verify if you are certain." >&2
  exit 1
}

# 1. No AI attribution. Write the message and stop.
if printf '%s' "$BODY" | grep -qiE '^[[:space:]]*(co-authored-by:[[:space:]]*claude|claude-session:)|generated with \[?claude'; then
  fail "AI attribution trailer found. Remove it."
fi

# 2. No competitor product names. Git metadata is a different artifact with a
#    different audience, and a merged PR's branch name cannot be edited
#    afterwards. Describe what the commit does, not who it is about.
#
#    The list of names lives in .githooks/competitors.local, which is NOT
#    tracked (see .gitignore). This file is public: a checked-in enumeration of
#    competitors would itself be the artifact this rule exists to prevent, and
#    it would be the first thing a reader greps for. With no local file the
#    check is skipped and the judgment is yours — CLAUDE.md carries the rule.
#
#    Format: one extended-regex alternation, e.g. `foocorp|bar[ -]baz`. Leave
#    out names that are ordinary English words; a guard that trips on everyday
#    prose gets --no-verify'd into uselessness. Leave out anything under about
#    five characters, which trips on test fixtures and ref names. Note that
#    substrings match: a bare `difflin` would fire on the identifier
#    `DiffLineRow`, which appears throughout the UI.
#
#    Looked up in this checkout first, then in the main checkout. Every agent
#    run commits from a worktree under .agency/worktrees/, where
#    --show-toplevel is the worktree and the gitignored file does not exist, so
#    the lookup as first written skipped the check on exactly the commits it
#    was added for. --git-common-dir is the main checkout's .git from any
#    worktree, and its parent is the checkout that holds the file.
COMPETITORS_FILE="$(git rev-parse --show-toplevel)/.githooks/competitors.local"
if [ ! -f "$COMPETITORS_FILE" ]; then
  COMPETITORS_FILE="$(cd "$(git rev-parse --git-common-dir)/.." && pwd)/.githooks/competitors.local"
fi
if [ -f "$COMPETITORS_FILE" ]; then
  COMPETITORS="$(tr -d '[:space:]' <"$COMPETITORS_FILE")"
  if [ -n "$COMPETITORS" ] &&
    printf '%s' "$BODY" | grep -qiE "(^|[^[:alnum:]])($COMPETITORS)([^[:alnum:]]|$)"; then
    fail "Competitor product name found. Describe the change, not the product."
  fi
fi

exit 0
