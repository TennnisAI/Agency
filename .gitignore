/target
ui/node_modules
ui/dist
crates/agency-app/gen
screenshots/

# TypeScript build state, and the compiled JS that `tsc -b` used to emit next
# to the Vite/Vitest config sources. The compiled copies must never be tracked:
# Vite resolves vite.config.js *before* vite.config.ts, so a stale emitted copy
# silently shadows the real config.
*.tsbuildinfo

# Vitest's on-disk cache. Written next to whichever directory the runner was
# invoked from, so it turns up at the repo root as readily as under ui/.
.vite/
ui/.vite/
ui/vite.config.js
ui/vite.config.d.ts
ui/vitest.config.js
ui/vitest.config.d.ts

.DS_Store

# Local state of coding-agent CLIs run inside this repo
.crush/

# Claude Code harness worktrees / local state
.claude/

# Superpowers/SDD scratch state. Only .superpowers/sdd/ self-ignores (a
# tool-written nested .gitignore holding `*`), so anything the tool writes
# beside that directory would otherwise show up as committable.
.superpowers/

# Agency's own worktrees + local state for this repo. Mirrors the exclude list
# the app writes into .git/info/exclude for every project it manages
# (worktree::ensure_agency_excludes) — deliberately per-path, not a blanket
# .agency/, so the shared config file stays trackable.
#
# Issue files are local because the app rewrites .agency/issues/*.md on every
# status change, so tracking them kept this checkout dirty (which is what merges
# refuse to start on) and put the same frontmatter lines on both sides of every
# agent merge. One local copy, shared by every worktree. See
# docs/tracked-issues.md.
#
# .agency/records/ is where a finished run's archive record is written, which is
# per-checkout by the same logic.
.agency/worktrees/
.agency/issues/
.agency/records/
.agency/agency.local.toml
/graphify-out/

# The commit-msg hook's competitor-name list. Deliberately untracked: this repo
# is public, and a checked-in list of competitors is the exact artifact the rule
# it enforces exists to prevent. Absent the file, the hook skips that check.
.githooks/competitors.local
/.vite/

# Wrangler's local cache. `wrangler pages deploy` writes the Cloudflare account
# id and email here, in the repo root, without being asked. Untracked is not
# enough on a public repo: one `git add -A` and it is published.
.wrangler/
