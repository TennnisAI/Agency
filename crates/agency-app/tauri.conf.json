{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agency",
  "version": "0.2.0",
  "identifier": "build.agency.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "cwd": "../../ui", "script": "pnpm dev" },
    "beforeBuildCommand": { "cwd": "../../ui", "script": "pnpm build" }
  },
  "app": {
    "windows": [
      { "title": "Agency", "width": 1280, "height": 832, "titleBarStyle": "Overlay", "hiddenTitle": true }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; font-src 'self'; frame-src 'self' data: http://localhost:* http://127.0.0.1:* http://[::1]:*" }
  },
  "bundle": {
    "active": true,
    "homepage": "https://getagency.dev/",
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 Nicholas Counts",
    "category": "DeveloperTool",
    "shortDescription": "Run coding agents side by side, each in its own git worktree",
    "longDescription": "Agency runs AI coding agents in parallel on your own machine. Each agent gets\na real terminal, its own git worktree and its own branch, so agents never step\non each other or on your checkout.\n\nGive an agent a task, watch it work live, review what it changed and merge the\nruns you like. Agency launches the agent command line tools you already have\ninstalled; the agents are third party and talk to their own providers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../../target/release/agency-termd"],
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["libc6 (>= 2.34)"],
        "files": {
          "/usr/share/metainfo/build.agency.app.metainfo.xml": "linux/build.agency.app.metainfo.xml",
          "/usr/share/doc/agency/copyright": "linux/copyright",
          "/usr/share/doc/agency/LICENSE": "../../LICENSE",
          "/usr/share/doc/agency/NOTICE": "../../NOTICE",
          "/usr/share/doc/agency/THIRD-PARTY.md": "../../THIRD-PARTY.md"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/build.agency.app.metainfo.xml": "linux/build.agency.app.metainfo.xml",
          "/usr/share/doc/agency/copyright": "linux/copyright",
          "/usr/share/doc/agency/LICENSE": "../../LICENSE",
          "/usr/share/doc/agency/NOTICE": "../../NOTICE",
          "/usr/share/doc/agency/THIRD-PARTY.md": "../../THIRD-PARTY.md"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/build.agency.app.metainfo.xml": "linux/build.agency.app.metainfo.xml"
        }
      }
    },
    "macOS": {
      "signingIdentity": "Developer ID Application: Nicholas Counts (9XD5R448N5)",
      "hardenedRuntime": true,
      "entitlements": "Agency.entitlements",
      "minimumSystemVersion": "11.0"
    }
  }
}
