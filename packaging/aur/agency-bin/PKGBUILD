# Maintainer: Nicholas Counts <hello@tennnis.no>
#
# The release .deb, repackaged. Tauri's bundler has no pacman target, and the
# .deb is the build CI has already checked (glibc floor, desktop file,
# AppStream metainfo, lintian), so this unpacks it rather than building from
# source. The copy in the Agency repository (packaging/aur/) is the source of
# truth: update.sh there points it at a release, and the AUR is pushed from it.

pkgname=agency-bin
# The published release this points at. update.sh rewrites it, pkgrel and the
# checksums below from that release; 0.2.0 is the first to carry Linux packages.
pkgver=0.2.2
pkgrel=1
pkgdesc='Run coding agents side by side, each in its own git worktree'
arch=('x86_64' 'aarch64')
url='https://getagency.dev/'
license=('Apache-2.0')
# The .deb's Depends under their Arch names, plus xdg-utils: tauri-plugin-opener
# shells out to xdg-open for every link and file Agency opens, and the .deb gets
# away without it only because every Debian desktop already has it.
depends=('glibc' 'gtk3' 'webkit2gtk-4.1' 'libayatana-appindicator' 'xdg-utils'
         'hicolor-icon-theme')
optdepends=('git: every project is a git repository; Agency offers to install it'
            'npm: most agent CLIs install through npm'
            'github-cli: the GitHub import and pull request flows')
provides=('agency')
conflicts=('agency')
_release="https://github.com/TennnisAI/Agency/releases/download/v${pkgver}"
source_x86_64=("${_release}/Agency_${pkgver}_amd64.deb")
source_aarch64=("${_release}/Agency_${pkgver}_arm64.deb")
# Written by update.sh from the release's own .deb files, never by hand. A value
# that is not a real checksum makes makepkg fail the integrity check rather than
# build anything.
sha256sums_x86_64=('d52257041e09ff7ebf8cdfa240192324aabde11ee4833fbf65b420ea508d3d89')
sha256sums_aarch64=('8baa1665a4c16dd742b0eedc74436158ca353542f51655904e1cdf6f74a03f34')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  # Arch keeps licences under /usr/share/licenses; the .deb puts them with the
  # docs, where they stay as well.
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" \
    "$pkgdir/usr/share/doc/agency/LICENSE" "$pkgdir/usr/share/doc/agency/NOTICE"
}
